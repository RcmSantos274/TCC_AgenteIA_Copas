# Copie este arquivo para ".env" e preencha os valores.

# Banco principal (ingestão/dashboard) — connection string do Neon
# (https://console.neon.tech -> Connection Details) ou do Postgres local.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Banco usado pelo agente — usuário SOMENTE-LEITURA (criado com agente/sql/criar_role_readonly.sql).
AGENT_DATABASE_URL=postgresql://agente_readonly:password@localhost:5432/copas_mundo

# LLM do agente. GPT-4o-mini via OpenAI; para Ollama use ex.: ollama/gemma3
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
